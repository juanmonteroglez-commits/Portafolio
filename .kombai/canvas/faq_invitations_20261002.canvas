      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap');\n  :root {\n    --ivory: #F7F1E4;\n    --outer: #E3D6BB;\n    --outer-deep: #D8C9A8;\n    --ink: #2B2118;\n    --ink-soft: #5B4E3F;\n    --burgundy: #7A2E38;\n    --gold: #AD8A4E;\n    --gold-soft: rgba(173,138,78,.35);\n    --line: rgba(43,33,24,.16);\n    --shadow: rgba(43,33,24,.10);\n  }\n  body {\n    margin: 0;\n    color: var(--ink);\n    background: var(--outer);\n    background-image: radial-gradient(ellipse 90% 60% at 50% -8%, var(--outer-deep) 0%, var(--outer) 55%);\n    font-family: 'Jost', sans-serif;\n    font-weight: 300;\n    -webkit-font-smoothing: antialiased;\n  }\n  .faq-page {\n    position: relative;\n    width: min(660px, calc(100% - 32px));\n    margin: 32px auto;\n    padding: 0 0 40px;\n    overflow: hidden;\n    background: var(--ivory);\n    border: 1px solid var(--gold-soft);\n    box-shadow: 0 30px 70px -25px var(--shadow), 0 2px 0 var(--gold-soft) inset;\n  }\n  .portfolio-context {\n    display: grid;\n    gap: 16px;\n    padding: 30px 34px 2px;\n  }\n  .invitation-card {\n    display: block;\n    overflow: hidden;\n    color: inherit;\n    text-decoration: none;\n    background: var(--ivory);\n    border: 1px solid var(--line);\n    box-shadow: 0 10px 26px -14px var(--shadow);\n  }\n  .invitation-preview {\n    display: flex;\n    height: 94px;\n    align-items: center;\n    justify-content: center;\n    background: linear-gradient(135deg, #e7ede4, #cddccd);\n  }\n  .invitation-preview svg {\n    width: 36px;\n    height: 36px;\n    color: var(--ink);\n    opacity: .55;\n  }\n  .invitation-meta {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    gap: 10px;\n    padding: 12px 16px 13px;\n    border-top: 1px solid var(--line);\n  }\n  .invitation-meta strong {\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 16px;\n    font-weight: 500;\n  }\n  .invitation-meta em {\n    color: var(--burgundy);\n    font-size: 13px;\n    font-style: normal;\n    white-space: nowrap;\n  }\n  .flourish {\n    display: flex;\n    align-items: center;\n    gap: 14px;\n    margin: 38px 34px 26px;\n  }\n  .flourish::before, .flourish::after {\n    content: '';\n    flex: 1;\n    height: 1px;\n    background: var(--line);\n  }\n  .flourish span {\n    color: var(--gold);\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 16px;\n    font-style: italic;\n    white-space: nowrap;\n  }\n  .faq-section {\n    padding: 0 34px 34px;\n  }\n  .faq-item {\n    border-bottom: 1px solid var(--line);\n  }\n  .faq-item:first-child {\n    border-top: 1px solid var(--line);\n  }\n  .faq-item summary {\n    position: relative;\n    display: flex;\n    min-height: 62px;\n    align-items: center;\n    justify-content: space-between;\n    gap: 18px;\n    padding: 14px 4px;\n    color: var(--ink);\n    cursor: pointer;\n    list-style: none;\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 20px;\n    font-weight: 500;\n    line-height: 1.25;\n  }\n  .faq-item summary::-webkit-details-marker { display: none; }\n  .faq-item summary::after {\n    content: '+';\n    flex: 0 0 24px;\n    color: var(--burgundy);\n    font-family: 'Jost', sans-serif;\n    font-size: 23px;\n    font-weight: 300;\n    line-height: 1;\n    text-align: center;\n  }\n  .faq-item[open] summary::after { content: '−'; }\n  .faq-item summary:focus-visible {\n    outline: 2px solid var(--burgundy);\n    outline-offset: 3px;\n  }\n  .faq-answer {\n    max-width: 520px;\n    padding: 0 36px 20px 4px;\n    color: var(--ink-soft);\n    font-size: 14px;\n    line-height: 1.7;\n  }\n  .farewell-start {\n    padding: 0 34px 0;\n    text-align: center;\n  }\n  .farewell-start h2 {\n    margin: 0 0 10px;\n    color: var(--ink);\n    font-family: 'Cormorant Garamond', serif;\n    font-size: 28px;\n    font-weight: 500;\n    line-height: 1.2;\n  }\n  .farewell-start p {\n    max-width: 440px;\n    margin: 0 auto;\n    color: var(--ink-soft);\n    font-size: 14px;\n    line-height: 1.7;\n  }\n  @media (max-width: 520px) {\n    .faq-page { width: calc(100% - 24px); margin: 18px auto; }\n    .portfolio-context, .faq-section, .farewell-start { padding-right: 22px; padding-left: 22px; }\n    .flourish { margin-right: 22px; margin-left: 22px; }\n    .faq-item summary { font-size: 19px; gap: 12px; }\n    .faq-answer { padding-right: 28px; }\n  }\n</style>\n<div class=\"faq-page\" data-kid=\"1\" data-name=\"faq and portfolio page container\">\n    <div aria-label=\"Últimas invitaciones del portafolio\" class=\"portfolio-context\" data-kid=\"1-1\" data-name=\"portfolio section\">\n        <a aria-label=\"Ver invitación Baby Shower\" class=\"invitation-card\" data-kid=\"1-1-1\" data-name=\"invitation project link\" href=\"https://juanmonteroglez-commits.github.io/Baby_Shower/\" rel=\"noopener\" target=\"_blank\">\n            <div aria-hidden=\"true\" class=\"invitation-preview\" data-kid=\"1-1-1-1\" data-name=\"invitation preview area\">\n                <svg data-kid=\"1-1-1-1-1\" data-name=\"baby carriage icon\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.1\" viewbox=\"0 0 44 44\">\n                    <path d=\"M14 20c0-5 3.5-9 8-9s8 4 8 9\">\n                    </path>\n                    <path d=\"M9 20h26v3a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5v-3z\">\n                    </path>\n                    <path d=\"M22 11V7\">\n                    </path>\n                </svg>\n            </div>\n            <div class=\"invitation-meta\" data-kid=\"1-1-1-2\" data-name=\"invitation meta info\">\n                <strong data-kid=\"1-1-1-2-1\" data-name=\"invitation type label\">\n                    Baby Shower\n                </strong>\n                <em data-kid=\"1-1-1-2-2\" data-name=\"view invitation action label\">\n                    Ver invitación\n                </em>\n            </div>\n        </a>\n    </div>\n    <div class=\"flourish\" data-kid=\"1-2\" data-name=\"decorative flourish container\">\n        <span aria-level=\"2\" data-kid=\"1-2-1\" data-name=\"faq section header\" role=\"heading\">\n            preguntas frecuentes\n        </span>\n    </div>\n    <section aria-label=\"Preguntas frecuentes\" class=\"faq-section\" data-kid=\"1-3\" data-name=\"faq section\">\n        <details class=\"faq-item\" data-kid=\"1-3-1\" data-name=\"faq item 1\" open=\"\">\n            <summary data-kid=\"1-3-1-1\" data-name=\"faq 1 question\">\n                ¿La invitación se hace desde cero?\n            </summary>\n            <div class=\"faq-answer\" data-kid=\"1-3-1-2\" data-name=\"faq 1 answer\">\n                Sí. Diseño cada proyecto desde cero y ajustamos juntos colores, textos y detalles.\n            </div>\n        </details>\n        <details class=\"faq-item\" data-kid=\"1-3-2\" data-name=\"faq item 2\">\n            <summary data-kid=\"1-3-2-1\" data-name=\"faq 2 question\">\n                ¿Para qué eventos haces invitaciones?\n            </summary>\n            <div class=\"faq-answer\" data-kid=\"1-3-2-2\" data-name=\"faq 2 answer\">\n                Para bodas, XV años, baby showers, cumpleaños infantiles y eventos corporativos.\n            </div>\n        </details>\n        <details class=\"faq-item\" data-kid=\"1-3-3\" data-name=\"faq item 3\">\n            <summary data-kid=\"1-3-3-1\" data-name=\"faq 3 question\">\n                ¿Cómo recibo y comparto la invitación?\n            </summary>\n            <div class=\"faq-answer\" data-kid=\"1-3-3-2\" data-name=\"faq 3 answer\">\n                Te entrego un enlace listo para compartir por WhatsApp o redes. Tus invitados no necesitan instalar una app.\n            </div>\n        </details>\n        <details class=\"faq-item\" data-kid=\"1-3-4\" data-name=\"faq item 4\">\n            <summary data-kid=\"1-3-4-1\" data-name=\"faq 4 question\">\n                ¿Qué te envío para empezar?\n            </summary>\n            <div class=\"faq-answer\" data-kid=\"1-3-4-2\" data-name=\"faq 4 answer\">\n                Escríbeme por WhatsApp con la fecha, el estilo que imaginas y los datos que quieres incluir.\n            </div>\n        </details>\n    </section>\n    <div class=\"flourish\" data-kid=\"1-4\" data-name=\"secondary decorative flourish container\">\n        <span data-kid=\"1-4-1\" data-name=\"farewell section label\">\n            hasta pronto\n        </span>\n    </div>\n    <section aria-label=\"Despedida\" class=\"farewell-start\" data-kid=\"1-5\" data-name=\"farewell section\">\n        <h2 data-kid=\"1-5-1\" data-name=\"farewell headline\">\n            Gracias por elegirnos\n        </h2>\n        <p data-kid=\"1-5-2\" data-name=\"farewell message text\">\n            Le agradecemos por confiar en nosotros para crear su invitación especial. Esperamos que su evento sea un éxito y que todos disfruten de la celebración.\n        </p>\n    </section>\n</div>\n",
      "comments": [],
      "created": "2026-10-02T23:24:54.841726+00:00",
      "modified": "2026-10-02T23:25:37.277146+00:00",
